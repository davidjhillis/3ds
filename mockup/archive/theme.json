{
  "$schema": "https://design-tokens.org/schemas/v1.0.0",
  "name": "DCX Documentation Theme",
  "version": "1.0.0",
  "description": "Design token system for DCX documentation templates",

  "tokens": {
    "color": {
      "brand": {
        "primary": {
          "50":  { "value": "#EEF2FF", "type": "color", "description": "Lightest primary shade" },
          "100": { "value": "#E0E7FF", "type": "color" },
          "200": { "value": "#C7D2FE", "type": "color" },
          "300": { "value": "#A5B4FC", "type": "color" },
          "400": { "value": "#818CF8", "type": "color" },
          "500": { "value": "#6366F1", "type": "color", "description": "Primary brand color" },
          "600": { "value": "#4F46E5", "type": "color" },
          "700": { "value": "#4338CA", "type": "color" },
          "800": { "value": "#3730A3", "type": "color" },
          "900": { "value": "#312E81", "type": "color" },
          "950": { "value": "#1E1B4B", "type": "color", "description": "Darkest primary shade" }
        },
        "accent": {
          "50":  { "value": "#FAF5FF", "type": "color" },
          "100": { "value": "#F3E8FF", "type": "color" },
          "200": { "value": "#E9D5FF", "type": "color" },
          "300": { "value": "#D8B4FE", "type": "color" },
          "400": { "value": "#C084FC", "type": "color" },
          "500": { "value": "#A855F7", "type": "color", "description": "Accent color for highlights" },
          "600": { "value": "#9333EA", "type": "color" },
          "700": { "value": "#7E22CE", "type": "color" },
          "800": { "value": "#6B21A8", "type": "color" },
          "900": { "value": "#581C87", "type": "color" },
          "950": { "value": "#3B0764", "type": "color" }
        },
        "neutral": {
          "50":  { "value": "#F9FAFB", "type": "color" },
          "100": { "value": "#F3F4F6", "type": "color" },
          "200": { "value": "#E5E7EB", "type": "color" },
          "300": { "value": "#D1D5DB", "type": "color" },
          "400": { "value": "#9CA3AF", "type": "color" },
          "500": { "value": "#6B7280", "type": "color" },
          "600": { "value": "#4B5563", "type": "color" },
          "700": { "value": "#374151", "type": "color" },
          "800": { "value": "#1F2937", "type": "color" },
          "900": { "value": "#111827", "type": "color" },
          "950": { "value": "#030712", "type": "color" }
        }
      },

      "semantic": {
        "background": {
          "primary":   { "value": "{color.brand.neutral.50}", "type": "color", "description": "Main background color" },
          "secondary": { "value": "{color.brand.neutral.100}", "type": "color", "description": "Secondary background" },
          "tertiary":  { "value": "{color.brand.neutral.200}", "type": "color" },
          "elevated":  { "value": "#FFFFFF", "type": "color", "description": "Cards, modals, elevated surfaces" },
          "inverse":   { "value": "{color.brand.neutral.900}", "type": "color" }
        },
        "text": {
          "primary":   { "value": "{color.brand.neutral.900}", "type": "color", "description": "Primary text color" },
          "secondary": { "value": "{color.brand.neutral.600}", "type": "color", "description": "Secondary text" },
          "tertiary":  { "value": "{color.brand.neutral.500}", "type": "color" },
          "inverse":   { "value": "#FFFFFF", "type": "color", "description": "Text on dark backgrounds" },
          "link":      { "value": "{color.brand.primary.600}", "type": "color" },
          "link-hover": { "value": "{color.brand.primary.700}", "type": "color" }
        },
        "border": {
          "default": { "value": "{color.brand.neutral.200}", "type": "color" },
          "subtle":  { "value": "{color.brand.neutral.100}", "type": "color" },
          "strong":  { "value": "{color.brand.neutral.300}", "type": "color" },
          "focus":   { "value": "{color.brand.primary.500}", "type": "color" }
        },
        "status": {
          "success": { "value": "#10B981", "type": "color" },
          "warning": { "value": "#F59E0B", "type": "color" },
          "error":   { "value": "#EF4444", "type": "color" },
          "info":    { "value": "#3B82F6", "type": "color" }
        }
      }
    },

    "spacing": {
      "layout": {
        "header-height": { "value": "70px", "type": "dimension", "description": "Main header height" },
        "sidebar-width": { "value": "280px", "type": "dimension" },
        "toc-width":     { "value": "260px", "type": "dimension" },
        "content-max":   { "value": "850px", "type": "dimension" }
      },
      "section": {
        "xs": { "value": "1rem", "type": "dimension" },
        "sm": { "value": "2rem", "type": "dimension" },
        "md": { "value": "4rem", "type": "dimension" },
        "lg": { "value": "6rem", "type": "dimension" },
        "xl": { "value": "8rem", "type": "dimension" }
      }
    },

    "typography": {
      "font-family": {
        "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "type": "fontFamily" },
        "mono": { "value": "JetBrains Mono, 'SF Mono', Monaco, monospace", "type": "fontFamily" }
      },
      "font-size": {
        "xs":   { "value": "0.75rem", "type": "dimension" },
        "sm":   { "value": "0.875rem", "type": "dimension" },
        "base": { "value": "1rem", "type": "dimension" },
        "lg":   { "value": "1.125rem", "type": "dimension" },
        "xl":   { "value": "1.25rem", "type": "dimension" },
        "2xl":  { "value": "1.5rem", "type": "dimension" },
        "3xl":  { "value": "1.875rem", "type": "dimension" },
        "4xl":  { "value": "2.25rem", "type": "dimension" },
        "5xl":  { "value": "3rem", "type": "dimension" },
        "6xl":  { "value": "3.75rem", "type": "dimension" }
      },
      "font-weight": {
        "normal":   { "value": "400", "type": "fontWeight" },
        "medium":   { "value": "500", "type": "fontWeight" },
        "semibold": { "value": "600", "type": "fontWeight" },
        "bold":     { "value": "700", "type": "fontWeight" },
        "extrabold": { "value": "800", "type": "fontWeight" }
      },
      "line-height": {
        "tight":  { "value": "1.25", "type": "number" },
        "normal": { "value": "1.5", "type": "number" },
        "relaxed": { "value": "1.75", "type": "number" }
      },
      "letter-spacing": {
        "tight":  { "value": "-0.02em", "type": "dimension" },
        "normal": { "value": "0", "type": "dimension" },
        "wide":   { "value": "0.05em", "type": "dimension" }
      }
    },

    "effects": {
      "shadow": {
        "none": { "value": "none", "type": "shadow" },
        "sm":   { "value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "type": "shadow" },
        "md":   { "value": "0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04)", "type": "shadow" },
        "lg":   { "value": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04)", "type": "shadow" },
        "xl":   { "value": "0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.04)", "type": "shadow" },
        "2xl":  { "value": "0 25px 50px -12px rgba(0, 0, 0, 0.15)", "type": "shadow" }
      },
      "border-radius": {
        "none": { "value": "0", "type": "dimension" },
        "sm":   { "value": "0.375rem", "type": "dimension" },
        "md":   { "value": "0.5rem", "type": "dimension" },
        "lg":   { "value": "0.75rem", "type": "dimension" },
        "xl":   { "value": "1rem", "type": "dimension" },
        "2xl":  { "value": "1.5rem", "type": "dimension" },
        "full": { "value": "9999px", "type": "dimension" }
      },
      "transition": {
        "fast": { "value": "150ms cubic-bezier(0.4, 0, 0.2, 1)", "type": "duration" },
        "base": { "value": "200ms cubic-bezier(0.4, 0, 0.2, 1)", "type": "duration" },
        "slow": { "value": "300ms cubic-bezier(0.4, 0, 0.2, 1)", "type": "duration" }
      }
    }
  },

  "modes": {
    "dark": {
      "color": {
        "semantic": {
          "background": {
            "primary":   { "value": "#0D1117", "type": "color" },
            "secondary": { "value": "#161B22", "type": "color" },
            "tertiary":  { "value": "#1C2128", "type": "color" },
            "elevated":  { "value": "#21262D", "type": "color" },
            "inverse":   { "value": "#FFFFFF", "type": "color" }
          },
          "text": {
            "primary":   { "value": "#E6EDF3", "type": "color" },
            "secondary": { "value": "#8D96A0", "type": "color" },
            "tertiary":  { "value": "#6E7681", "type": "color" },
            "inverse":   { "value": "#0D1117", "type": "color" },
            "link":      { "value": "{color.brand.primary.400}", "type": "color" },
            "link-hover": { "value": "{color.brand.primary.300}", "type": "color" }
          },
          "border": {
            "default": { "value": "#30363D", "type": "color" },
            "subtle":  { "value": "#21262D", "type": "color" },
            "strong":  { "value": "#444C56", "type": "color" },
            "focus":   { "value": "{color.brand.primary.500}", "type": "color" }
          }
        }
      },
      "effects": {
        "shadow": {
          "sm":  { "value": "0 1px 2px 0 rgba(0, 0, 0, 0.3)", "type": "shadow" },
          "md":  { "value": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3)", "type": "shadow" },
          "lg":  { "value": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4)", "type": "shadow" },
          "xl":  { "value": "0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5)", "type": "shadow" },
          "2xl": { "value": "0 25px 50px -12px rgba(0, 0, 0, 0.7)", "type": "shadow" }
        }
      }
    }
  }
}
